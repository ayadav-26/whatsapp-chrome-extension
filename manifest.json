{
  "manifest_version": 3,
  "name": "WhatsApp Web Message Monitor & Sender",
  "version": "1.3.0",
  "description": "Production-quality Chrome Extension for real-time message monitoring, capture, automatic message & attachment sending, and smart tab reuse on WhatsApp Web.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "utils/constants.js",
        "utils/helpers.js",
        "utils/tabManager.js",
        "utils/domHelper.js",
        "utils/chatNavigator.js",
        "utils/attachmentUploader.js",
        "utils/messageSender.js",
        "utils/mediaParser.js",
        "utils/messageParser.js",
        "utils/storage.js",
        "utils/chatDetector.js",
        "utils/syncManager.js",
        "utils/observer.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WhatsApp Monitor & Sender"
  }
}
